{
  "name": "tei-odd-interpreter",
  "version": "0.1.0",
  "description": "Reads a TEI ODD and renders TEI by its Processing Model",
  "keywords": ["tei", "odd", "processing-model", "digital-edition", "hast"],
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cforney/tei-odd-interpreter.git"
  },
  "homepage": "https://github.com/cforney/tei-odd-interpreter#readme",
  "bugs": "https://github.com/cforney/tei-odd-interpreter/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.3",
    "@types/hast": "^3.0.4",
    "@types/xast": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
